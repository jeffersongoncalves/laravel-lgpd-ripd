{
    "name": "jeffersongoncalves/laravel-lgpd-ripd",
    "description": "LGPD data protection impact assessment (RIPD) for Laravel: risks scored by likelihood and impact with LINDDUN threats, mitigations and residual risk, DPO opinion, approval and periodic review, linked to the records of processing.",
    "keywords": [
        "laravel",
        "lgpd",
        "ripd",
        "dpia",
        "impact-assessment",
        "linddun",
        "risk",
        "privacy",
        "anpd",
        "gdpr"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-lgpd-ripd",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "jeffersongoncalves/laravel-lgpd": "^2.0",
        "jeffersongoncalves/laravel-lgpd-records": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\LgpdRipd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\LgpdRipd\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\LgpdRipd\\LgpdRipdServiceProvider"
            ],
            "aliases": {
                "LgpdRipd": "JeffersonGoncalves\\LgpdRipd\\Facades\\LgpdRipd"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
